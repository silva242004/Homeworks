

const numbers = [1, 2, 3, 4, 6, 7];
const students = ["Ana", "Gio", "Jackson", "Mari"];



// push() → adds element to the end
numbers.push(8);
console.log("push:", numbers);

// pop() → removes last element
numbers.pop();
console.log("pop:", numbers);

// map() → transforms each element
const doubled = numbers.map(n => n * 2);
console.log("map: ", doubled);

// filter() → keeps elements that match condition
const even = numbers.filter(n => n % 2 === 0);
console.log("filter:", even);

// find() → returns first element that matches condition
const found = numbers.find(n => n > 3);
console.log("find:", found);

// reduce() → reduces array to a single value
const sum = numbers.reduce((total, n) => total + n, 0);
console.log("reduce:", sum);

// forEach() → iterates over each element (no return)
students.forEach(s => console.log("forEach:", s));


//  SEARCH FUNCTIONS


// includes() → checks if element exists
console.log("includes 3:", numbers.includes(3));

// indexOf() → returns first index of element (-1 if not found)
console.log("indexOf 3:", numbers.indexOf(3));

// lastIndexOf() → returns last index of element
const repeated = [1, 2, 3, 2, 4];
console.log("lastIndexOf 2: ", repeated.lastIndexOf(2));

// some() → true if at least one element matches condition
console.log("some > 4:", numbers.some(n => n > 4));

// every() → true if all elements match condition
console.log("every > 0:", numbers.every(n => n > 0));

//  ARRAY MANIPULATION


// slice() → returns a portion of the array (non-destructive)
console.log("slice:", numbers.slice(1, 3));

// splice() → removes or inserts elements (destructive)
const spliceExample = [...numbers];
spliceExample.splice(2, 1);
console.log("splice:", spliceExample);

// concat() → merges two or more arrays
const moreNumbers = [7, 8, 9];
console.log("concat:", numbers.concat(moreNumbers));

// join() → converts array to string with separator
console.log("join:", students.join(", "));

// reverse() → reverses order (non-destructive copy)
console.log("reverse:", [...numbers].reverse());

// sort() → sorts elements (non-destructive copy)
const unsorted = [5, 2, 8, 1, 4];
console.log("sort:", [...unsorted].sort((a, b) => a - b));


//  MODERN ARRAY FUNCTIONS 


// flat() → flattens nested arrays one level deep
const nested = [1, [2, 3], [4, 5]];
console.log("flat:", nested.flat());

// flatMap() → maps then flattens one level
console.log("flatMap:", numbers.flatMap(n => [n, n * 2]));

// Array.from() → creates array from iterable
console.log("Array.from:", Array.from("hello"));

// Array.isArray() → checks if value is an array
console.log("isArray:", Array.isArray(numbers));

// at() → accesses element by index (supports negative)
console.log("at(-1):", numbers.at(-1));